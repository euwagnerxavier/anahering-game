# Copie para /etc/anahering.env no Pi (o setup-pi.sh gera um automaticamente).
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/anahering/anahering.db
# Sal fixo para o hash de IPs (limites diários sobrevivem a reinícios)
IP_SALT=troque-por-um-valor-aleatorio
# Token para moderação: DELETE /api/admin/decrees/:id com "Authorization: Bearer <token>"
ADMIN_TOKEN=troque-por-um-token-longo
# Confiar no cabeçalho CF-Connecting-IP vindo do cloudflared local
TRUST_CLOUDFLARE=true
# Origens permitidas para o WebSocket (vazio = mesma origem do Host)
ALLOWED_ORIGINS=
MAX_PLAYERS=100
MAX_CONN_PER_IP=3
DECREES_PER_DAY=20
EVENT_INTERVAL_MS=480000
